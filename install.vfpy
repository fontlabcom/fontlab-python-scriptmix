#FLM: Install this package into FontLab
# this_file: install.vfpy
"""Install the Python package in this folder into FontLab 9. Standard library only.

Open this file in FontLab 9 (double-click it, or drop it onto FontLab). It reads
pyproject.toml beside it; [tool.fontlab-install] id names the extension in
reverse-domain form (e.g. com.fontlab.fly). FontLab reports its user data folder
(fontlab.flPreferences().dataPathDefault); everything goes inside it:

- python/3.11/site-packages: FontLab's own package folder, always a real folder.
  Each package of this distribution is placed there as a symlink (to a Git
  checkout: editable; or to Extensions/<id>/lib/ for a plain folder such as a
  downloaded ZIP), with a .dist-info record. No .pth processing is needed.
- .venv: created with uv (https://docs.astral.sh/uv/) from the same Python
  version and processor type as FontLab's own Python. Its site-packages is a
  symlink to FontLab's folder, so `uv pip install --python .venv/bin/python X`
  installs X straight into FontLab. Dependencies are installed this way.
- Extensions/<id>/install.log: one JSON object per line, appended on every
  install or uninstall; the last line lists every file the install created.
- Scripts: files from this folder's Scripts/ (and from folders listed in
  [tool.fontlab-install] scripts, as Scripts/<folder>) are copied in afresh on
  every install, replacing any file at the same path; folders shared with other
  extensions merge.
- Dependencies are installed on every run: a required package whose checkout
  sits beside this folder (with its own install.vfpy) is installed from there
  first, since these are not on PyPI; uv installs the rest.
- Scripts/Extensions/: "List Extensions" and "Uninstall <id>" launchers. They
  import this same file, installed as site-packages/fontlab_install.py.

Optional [tool.fontlab-install] keys override pyproject values that do not fit
FontLab: name (the distribution record), packages (folders with __init__.py;
[] installs scripts only) and dependencies (what the scripts need in FontLab).

Restart FontLab afterwards.
"""
import datetime
import json
import os
import platform
import re
import runpy
import shutil
import subprocess
import sys
import tomllib
import traceback
import uuid
from importlib import metadata
from pathlib import Path

SOURCE = Path(__file__).resolve().parent
MODULE = "fontlab_install"  # name of this file when installed into site-packages
LOG = "install.log"
ACTIVE = "FONTLAB_INSTALL_ACTIVE"  # checkouts already installed in this run, shared by nested installers
VENV = ".venv"
VENV_DIRS = ("bin", "share", "include")  # where wheels put scripts, data and headers
MARKER = ".fontlab-install.json"  # marks copied folders this installer owns
MENU = "Extensions"  # Scripts submenu with the generated launchers
ID_PATTERN = re.compile(r"^[a-z][a-z0-9-]*(\.[a-z0-9][a-z0-9-]*)+$")
IGNORE = shutil.ignore_patterns("__pycache__", "*.pyc", ".DS_Store", "tests", "stubs")
SCRIPT_JUNK = shutil.ignore_patterns("__pycache__", "*.pyc", "*.vfpyc", ".DS_Store")
UV_CANDIDATES = ("~/.local/bin/uv", "~/.cargo/bin/uv", "/opt/homebrew/bin/uv", "/usr/local/bin/uv")
LAUNCHER = "#FLM: %s\n# Generated by install.vfpy; replaced on every install.\nimport fontlab_install\nfontlab_install.%s\n"
PROBE = "import json, os, platform, sys, sysconfig; print(json.dumps([list(sys.version_info[:2]), platform.machine(), os.path.realpath(sysconfig.get_paths()['purelib'])]))"


def data_dir():
    # Same lookup as FontLab's Scripts panel: honours redirected Windows Documents.
    import fontlab

    value = fontlab.flPreferences().dataPathDefault
    value = value() if callable(value) else value
    if not value:
        raise RuntimeError("FontLab did not report its user data folder.")
    return Path(str(value)).expanduser().resolve()


def site_dir(data):
    return data / "python" / ("%d.%d" % sys.version_info[:2]) / "site-packages"


def norm(name):
    return re.sub(r"[-_.]+", "_", name).lower()


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def run(command):
    return subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)


# --- install.log -----------------------------------------------------------


def read_log(home):
    """All records of one extension, oldest first."""
    path = home / LOG
    if not path.is_file():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def append_log(home, record):
    with (home / LOG).open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, sort_keys=True) + "\n")


def last_state(home):
    """The last install or uninstall record; failed attempts are history only."""
    records = [r for r in read_log(home) if r["action"] in ("install", "uninstall")]
    return records[-1] if records else None


def installed(data=None):
    """{id: last record} for every extension whose last action is install."""
    data = data or data_dir()
    result = {}
    for log in sorted((data / "Extensions").glob("*/" + LOG)):
        state = last_state(log.parent)
        if state and state["action"] == "install":
            result[log.parent.name] = state
    return result


def list_extensions(data=None):
    extensions = installed(data)
    for ext_id, record in extensions.items():
        print("%-28s %-12s %-7s %s  (%s)" % (ext_id, record["version"], record["mode"], record["source"], record["time"]))
    if not extensions:
        print("No extensions installed by install.vfpy.")
    return extensions


def remove_path(path, data):
    path = Path(os.path.abspath(str(path)))  # abspath, not resolve: never follow a link out
    if data not in path.parents:
        raise RuntimeError("Refusing to remove a path outside FontLab's data folder: %s" % path)
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(str(path))
    if path.suffix in (".py", ".vfpy"):  # FontLab compiles scripts in place: X.py -> X.pyc
        for compiled in (path.with_suffix(".pyc"), path.with_suffix(".vfpyc")):
            if compiled.is_file():
                compiled.unlink()
    scripts, parent = data / "Scripts", path.parent
    while scripts in parent.parents and parent.is_dir() and not any(parent.iterdir()):
        parent.rmdir()  # a merged folder goes when its last script goes
        parent = parent.parent


def uninstall(ext_id, data=None):
    """Remove everything the last install created; keep install.log as history."""
    data = data or data_dir()
    home = data / "Extensions" / ext_id
    state = last_state(home)
    if not state or state["action"] != "install":
        raise RuntimeError("%s is not installed." % ext_id)
    for path in state["files"]:
        remove_path(path, data)
    append_log(home, {"action": "uninstall", "id": ext_id, "name": state["name"], "time": now()})
    print("Uninstalled %s. Restart FontLab to unload it; %s keeps the history." % (ext_id, home / LOG))


# --- FontLab's site-packages and the matching venv ---------------------------


def prepare_site(data):
    """FontLab's site-packages must be a real folder; an older setup linked it into .venv."""
    site = site_dir(data)
    if site.is_symlink():
        real = site.resolve()
        site.unlink()
        if real.is_dir() and data in real.parents:
            shutil.move(str(real), str(site))  # keep what is installed there
            print("Moved %s to %s." % (real, site))
        elif real.is_dir():
            shutil.copytree(str(real), str(site), symlinks=True)
    site.mkdir(parents=True, exist_ok=True)
    return site


def venv_paths(venv):
    if os.name == "nt":
        return venv / "Scripts" / "python.exe", venv / "Lib" / "site-packages"
    return venv / "bin" / "python", venv / "lib" / ("python%d.%d" % sys.version_info[:2]) / "site-packages"


def python_requests():
    """uv requests for FontLab's own Python: exact version first, then the same minor version."""
    system = {"darwin": "macos", "win32": "windows"}.get(sys.platform, "linux")
    machine = platform.machine().lower()
    arch = {"arm64": "aarch64", "amd64": "x86_64"}.get(machine, machine)
    versions = ("%d.%d.%d" % sys.version_info[:3], "%d.%d" % sys.version_info[:2])
    return ["cpython-%s-%s-%s-none" % (v, system, arch) for v in versions]


def probe(python):
    if not python.is_file():
        return None
    result = run([str(python), "-I", "-c", PROBE])
    return json.loads(result.stdout) if result.returncode == 0 else None


def matches(found, site=None):
    """Same Python minor version and processor type as FontLab (and, if given, the same site-packages)."""
    return bool(found) and found[0] == list(sys.version_info[:2]) and found[1] == platform.machine() and (
        site is None or found[2] == os.path.realpath(str(site)))


def link_venv_site(vsite, site):
    """Make the venv's site-packages a symlink to FontLab's folder, keeping anything already in it."""
    if vsite.is_symlink() and vsite.resolve() == site.resolve():
        return
    if vsite.is_symlink():
        vsite.unlink()
    elif vsite.is_dir():
        for item in vsite.iterdir():
            # uv's _virtualenv helper patches distutils for the venv; FontLab must not load it.
            if not item.name.startswith("_virtualenv") and not (site / item.name).exists():
                shutil.move(str(item), str(site / item.name))
        shutil.rmtree(str(vsite))
    vsite.parent.mkdir(parents=True, exist_ok=True)
    os.symlink(str(site), str(vsite), target_is_directory=True)


def link_venv_dirs(data, venv):
    """Point data/bin, share, include back into the venv.

    uv writes console scripts and wheel data relative to site-packages
    (site-packages/../../../bin). Through the symlink, the OS resolves that from
    FontLab's real folder, i.e. data/bin, so these links send the files to the venv.
    """
    for name in VENV_DIRS:
        link, target = data / name, venv / name
        target.mkdir(exist_ok=True)
        if link.is_symlink() and link.resolve() == target.resolve():
            continue
        if link.is_symlink():
            link.unlink()
        elif link.exists():
            raise RuntimeError("Refusing to replace %s: uv needs it to point into %s." % (link, venv))
        os.symlink(str(target), str(link), target_is_directory=True)


def ensure_venv(data, site, uv):
    """Create or repair data/.venv to match FontLab's Python; return its python, or None."""
    venv = data / VENV
    python, vsite = venv_paths(venv)
    if not matches(probe(python)):
        if venv.exists() or venv.is_symlink():
            backup = venv.with_name("%s.backup-%s" % (VENV, uuid.uuid4().hex[:8]))
            os.replace(str(venv), str(backup))
            print("Kept the mismatched venv as %s." % backup)
        for request in python_requests():
            result = run([uv, "venv", "--managed-python", "--no-project", "--python", request, str(venv)])
            if result.returncode == 0:
                break
        else:
            raise RuntimeError("uv could not create a venv for FontLab's Python:\n" + result.stdout)
    try:
        link_venv_site(vsite, site)
        link_venv_dirs(data, venv)
    except OSError as error:  # e.g. Windows without symlink rights
        print("Could not link the venv to FontLab's site-packages (%s); installing without it." % error)
        return None
    if not matches(probe(python), site):
        raise RuntimeError("%s does not match FontLab's Python and site-packages." % venv)
    return python


# --- installing ------------------------------------------------------------


def version(project):
    pkg_info = SOURCE / "PKG-INFO"  # present in an unpacked sdist
    if pkg_info.is_file():
        for line in pkg_info.read_text(encoding="utf-8").splitlines():
            if line.startswith("Version: "):
                return line[9:].strip()
    try:
        out = subprocess.run(
            ["git", "-C", str(SOURCE), "describe", "--tags", "--long", "--match", "v[0-9]*.[0-9]*.[0-9]*"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True, timeout=20, check=True,
        ).stdout.strip()
        tag, distance, sha = out.rsplit("-", 2)
        return tag[1:] if distance == "0" else "%s+%s.%s" % (tag[1:], distance, sha)
    except (OSError, ValueError, subprocess.SubprocessError):
        options = project.get("tool", {}).get("hatch", {}).get("version", {}).get("raw-options", {})
        return options.get("fallback_version", "0.0.0")


def package_dirs(project, config):
    """Import packages: [tool.fontlab-install] packages, else the wheel's packages."""
    wheel = project.get("tool", {}).get("hatch", {}).get("build", {}).get("targets", {}).get("wheel", {})
    if "packages" in config:
        if not config["packages"]:
            return []  # a scripts-only extension
        wheel = config
    dirs = [SOURCE / p for p in wheel.get("packages", [])]
    if not dirs or not all((d / "__init__.py").is_file() for d in dirs):
        raise RuntimeError("pyproject.toml must list the wheel packages, each with __init__.py.")
    return dirs


def check_target(path):
    """Refuse to replace anything this installer did not create."""
    if path.is_symlink() or not path.exists():
        return
    if not (path / MARKER).is_file():
        raise RuntimeError("Refusing to replace a folder this installer does not manage: %s" % path)


def replace_dir(stage, target):
    """Swap a fully prepared folder into place; nothing changes if staging failed."""
    check_target(target)
    old = target.with_name(".%s.old-%s" % (target.name, uuid.uuid4().hex[:8]))
    if target.is_symlink():
        target.unlink()
    elif target.exists():
        os.replace(str(target), str(old))
    os.replace(str(stage), str(target))
    shutil.rmtree(str(old), ignore_errors=True)


def copy_tree(sources, target, owner):
    """Copy folders/files into target via a staging folder, after compiling all Python."""
    stage = target.with_name(".%s.new-%s" % (target.name, uuid.uuid4().hex[:8]))
    try:
        stage.mkdir(parents=True)
        for src in sources:
            if src.is_dir():
                shutil.copytree(str(src), str(stage / src.name), ignore=IGNORE)
            elif not IGNORE(str(src.parent), [src.name]):
                shutil.copy2(str(src), str(stage / src.name))
        for path in stage.rglob("*.py"):
            compile(path.read_bytes(), str(path), "exec")
        (stage / MARKER).write_text(json.dumps({"id": owner}) + "\n", encoding="utf-8")
        replace_dir(stage, target)
    finally:
        shutil.rmtree(str(stage), ignore_errors=True)


def script_sources(listed):
    """(file, path relative to FontLab's Scripts) for every script file the package ships.

    Sources: a top-level Scripts/ folder (whose files and subfolders map onto FontLab's
    Scripts/) and each folder listed in [tool.fontlab-install] scripts (mapped onto
    Scripts/<folder>/).
    """
    roots = [(SOURCE / name, Path()) for name in os.listdir(SOURCE) if name == "Scripts"]  # exact case:
    roots += [(SOURCE / name, Path(name)) for name in listed]  # a lowercase scripts/ often holds dev tools
    pairs = []
    for root, prefix in roots:
        for path in sorted(root.rglob("*")):
            rel = path.relative_to(root)
            if path.is_file() and not any(SCRIPT_JUNK(".", [part]) for part in rel.parts):
                pairs.append((path, prefix / rel))
    return pairs


def check_scripts(scripts, pairs, owned):
    """Refuse, before changing anything, only where a real folder or file blocks a script's path.

    Existing files at a script's path are replaced and folder links are replaced
    by real folders (see place_scripts); a real folder cannot become a file.
    """
    for _, rel in pairs:
        for depth in range(1, len(rel.parts) + 1):
            path = scripts.joinpath(*rel.parts[:depth])
            if path.is_symlink() or str(path) in owned:
                continue
            last = depth == len(rel.parts)
            if (last and path.is_dir()) or (not last and path.exists() and not path.is_dir()):
                raise RuntimeError("Refusing to replace %s: a script needs that path." % path)


def unlink_folder_links(scripts, rel):
    """Replace links on a script's folder path by real folders; never write through a link."""
    for depth in range(1, len(rel.parts)):
        path = scripts.joinpath(*rel.parts[:depth])
        if path.is_symlink():
            path.unlink()  # removes the link only; its target is untouched
            print("Replaced the folder link %s with a real folder." % path)


def place_scripts(scripts, pairs):
    """Copy every script file afresh into FontLab's Scripts, replacing what is at its path."""
    placed = []
    for source, rel in pairs:
        if source.suffix in (".py", ".vfpy"):
            compile(source.read_bytes(), str(source), "exec")
        target = scripts / rel
        unlink_folder_links(scripts, rel)
        if target.is_symlink() or target.exists():
            print("Replaced %s." % target)
            remove_path(target, scripts.parent)  # also drops stale compiled copies and empty folders
        target.parent.mkdir(parents=True, exist_ok=True)
        stage = target.with_name(".%s.new-%s" % (target.name, uuid.uuid4().hex[:8]))
        shutil.copy2(str(source), str(stage))
        os.replace(str(stage), str(target))
        placed.append(target)
    return placed


def remove_old_dist(site, name):
    """Remove an earlier install of this distribution (ours, uv or pip) using its RECORD."""
    for info in site.glob(norm(name) + "-*.dist-info"):
        record = info / "RECORD"
        rows = record.read_text(encoding="utf-8").splitlines() if record.is_file() else []
        tops = {Path(row.split(",")[0]).parts[0] for row in rows if row.split(",")[0]}
        for top in tops - {"..", info.name}:  # ".." entries are scripts outside site-packages
            path = site / top
            if path.is_symlink() or path.is_file():
                path.unlink()
            elif path.is_dir():
                shutil.rmtree(str(path))
        shutil.rmtree(str(info))


def write_record(site, name, ver, packages, requires):
    """Place each package in site-packages (symlink, else copy) and write a .dist-info."""
    remove_old_dist(site, name)
    placed = []
    for target in packages:
        link = site / target.name
        if link.is_symlink():
            link.unlink()
        elif link.exists():
            raise RuntimeError("Refusing to replace %s: another distribution owns it." % link)
        try:
            os.symlink(str(target), str(link), target_is_directory=True)
        except OSError:  # e.g. Windows without symlink rights: a copy is not editable
            shutil.copytree(str(target), str(link), ignore=IGNORE)
        placed.append(link)
    info = site / ("%s-%s.dist-info" % (norm(name), ver))
    info.mkdir()
    lines = ["Metadata-Version: 2.1", "Name: " + name, "Version: " + ver]
    lines += ["Requires-Dist: " + r for r in requires]
    (info / "METADATA").write_text("\n".join(lines) + "\n", encoding="utf-8")
    (info / "INSTALLER").write_text("install.vfpy\n", encoding="utf-8")
    # uv pip check treats a .dist-info without WHEEL as broken.
    wheel = "Wheel-Version: 1.0\nGenerator: install.vfpy\nRoot-Is-Purelib: true\nTag: py3-none-any\n"
    (info / "WHEEL").write_text(wheel, encoding="utf-8")
    files = [p.name for p in placed] + [info.name + "/" + f for f in ("METADATA", "INSTALLER", "WHEEL", "RECORD")]
    (info / "RECORD").write_text("".join(f + ",,\n" for f in files), encoding="utf-8")
    return placed + [info]


def write_tools(data, site, ext_id):
    """Install this file as fontlab_install.py and (re)generate the Scripts/Extensions launchers."""
    shutil.copyfile(__file__, str(site / (MODULE + ".py")))
    menu = data / "Scripts" / MENU
    check_target(menu)
    menu.mkdir(parents=True, exist_ok=True)
    (menu / MARKER).write_text(json.dumps({"id": MODULE}) + "\n", encoding="utf-8")
    (menu / "List Extensions.py").write_text(LAUNCHER % ("List Extensions", "list_extensions()"), encoding="utf-8")
    uninstaller = menu / ("Uninstall %s.py" % ext_id)
    uninstaller.write_text(LAUNCHER % ("Uninstall " + ext_id, "uninstall(%r)" % ext_id), encoding="utf-8")
    return [uninstaller]


def missing(requires):
    # No-uv fallback: checks presence only, not versions, markers or extras.
    result = []
    for req in requires:
        try:
            metadata.distribution(re.match(r"[A-Za-z0-9._-]+", req).group())
        except metadata.PackageNotFoundError:
            result.append(req)
    return result


def find_uv():
    for candidate in (shutil.which("uv"),) + UV_CANDIDATES:  # FontLab's GUI PATH is minimal
        if candidate and os.path.isfile(os.path.expanduser(candidate)):
            return os.path.expanduser(candidate)
    return None


def req_name(req):
    return norm(re.match(r"\s*([A-Za-z0-9._-]+)", req).group(1))


def siblings():
    """{distribution name: folder} for checkouts beside this one that this installer can install."""
    found = {}
    for folder in sorted(SOURCE.parent.iterdir()):
        toml = folder / "pyproject.toml"
        if folder == SOURCE or not (folder / "install.vfpy").is_file() or not toml.is_file():
            continue
        try:
            project = tomllib.loads(toml.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        config = project.get("tool", {}).get("fontlab-install", {})
        if ID_PATTERN.match(str(config.get("id", ""))):  # another installer would ignore our contract
            for name in {config.get("name"), project.get("project", {}).get("name")} - {None}:
                found.setdefault(norm(name), folder)
    return found


def active():
    return [p for p in os.environ.get(ACTIVE, "").split(os.pathsep) if p]


def install_siblings(requires):
    """Install required checkouts found beside this one (once per run); return the other requirements."""
    local, rest = siblings(), []
    for req in requires:
        folder = local.get(req_name(req))
        if folder is None:
            rest.append(req)
        elif str(folder.resolve()) not in active():  # already done, or in progress (a cycle)
            print("Installing dependency %s from %s" % (req, folder))
            runpy.run_path(str(folder / "install.vfpy"), run_name="fontlab_install_dependency")
    return rest


def install_dependencies(site, requires, uv, python):
    """Install every requirement on each run: sibling checkouts first, then all the rest with uv (it enforces versions)."""
    remote = install_siblings(requires)
    if not uv:
        needed = missing(remote)
        if needed:
            print("Missing dependencies (install uv, then run this again):\n  " + "\n  ".join(needed))
        return
    if not remote:
        return
    where = ["--python", str(python)] if python else ["--python", python_requests()[1], "--target", str(site)]
    command = [uv, "pip", "install", "--link-mode=copy"] + where + remote
    print("Installing dependencies: " + " ".join(command))
    result = run(command)
    print(result.stdout)
    if result.returncode:
        raise RuntimeError("uv could not install the dependencies (exit %d):\n%s" % (result.returncode, result.stdout))


def extension_home(data, ext_id):
    home = data / "Extensions" / ext_id
    # An empty folder is fine: a first install that failed part-way leaves one.
    if home.is_symlink() or (home.exists() and any(home.iterdir()) and not (home / LOG).is_file()):
        raise RuntimeError("Refusing to use a folder this installer does not manage: %s" % home)
    home.mkdir(parents=True, exist_ok=True)
    return home


def main():
    project = tomllib.loads((SOURCE / "pyproject.toml").read_text(encoding="utf-8"))
    config = project.get("tool", {}).get("fontlab-install", {})
    ext_id, scripts = config.get("id", ""), config.get("scripts", [])
    if not ID_PATTERN.match(ext_id):
        raise RuntimeError("pyproject.toml needs [tool.fontlab-install] id = \"com.example.name\".")
    name, ver = config.get("name", project["project"]["name"]), version(project)
    data = data_dir()
    home = extension_home(data, ext_id)
    outer = not active()
    os.environ[ACTIVE] = os.pathsep.join(active() + [str(SOURCE)])
    try:
        install(project, config, data, home, ext_id, scripts, name, ver)
    except Exception:
        # Keep the reason where List/Uninstall and people can find it; FontLab's Output may be closed.
        append_log(home, {"action": "failed", "id": ext_id, "name": name, "version": ver, "time": now(),
                          "source": str(SOURCE), "error": traceback.format_exc()})
        print("Install FAILED; details in %s" % (home / LOG))
        raise
    finally:
        if outer:
            os.environ.pop(ACTIVE, None)


def install(project, config, data, home, ext_id, scripts, name, ver):
    requires = config.get("dependencies", project["project"].get("dependencies", []))
    site = prepare_site(data)
    uv = find_uv()
    python = ensure_venv(data, site, uv) if uv else None
    if not uv:
        print("uv not found: no venv was set up. Install uv from https://docs.astral.sh/uv/ for dependencies.")
    dirs = package_dirs(project, config)
    editable = (SOURCE / ".git").exists()
    previous = last_state(home)
    owned = set(previous["files"]) if previous and previous["action"] == "install" else set()
    script_dir = data / "Scripts"
    pairs = script_sources(scripts)
    check_scripts(script_dir, pairs, owned)
    old_scripts = {old for old in owned if script_dir in Path(old).parents}
    for old in sorted(old_scripts):  # last install's scripts; this install copies them afresh
        remove_path(old, data)
    owned -= old_scripts  # else an old folder link's path would be swept again after the copy
    files = []
    if editable or not dirs:
        packages = dirs
    else:
        copy_tree(dirs, home / "lib", ext_id)
        packages = [home / "lib" / d.name for d in dirs]
        files.append(home / "lib")
    files += place_scripts(script_dir, pairs)
    if packages:  # scripts-only extensions need no distribution record
        files += write_record(site, name, ver, packages, requires)
    files += write_tools(data, site, ext_id)
    for stale in owned - {str(f) for f in files}:  # e.g. copied -> linked leaves lib/ behind
        remove_path(stale, data)
    append_log(home, {
        "action": "install", "id": ext_id, "name": name, "version": ver, "time": now(),
        "mode": "linked" if editable else "copied", "source": str(SOURCE),
        "requires": requires, "files": [str(f) for f in files],
    })
    install_dependencies(site, requires, uv, python)
    loaded = [d.name for d in dirs if d.name in sys.modules]
    print("Installed %s %s as %s (%s); log: %s" % (name, ver, ext_id, "linked" if editable else "copied", home / LOG))
    if python:
        print("Add packages with: uv pip install --python %s <package>" % python)
    print("Scripts > %s lists and uninstalls extensions. Use Refresh Scripts if needed." % MENU)
    print("Restart FontLab to load it." + (" Already loaded: " + ", ".join(loaded) if loaded else ""))


if __name__ != MODULE:  # run as a FontLab script; importing fontlab_install only defines the tools
    main()
